# Copy to .env.local. This file is documentation only; never commit the copy.
HOST=127.0.0.1
PORT=8787
WORLDENGINE_DATA_DIR=../../.worldengine/data
WORLDENGINE_PROVIDER_POLICY_FILE=../../.worldengine/provider-policy.json
WORLDENGINE_ALLOWED_ORIGINS=

# Server-side BYOK credentials. Fill only after reviewing the matching policy.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
WAVESPEED_API_KEY=
TRIPO_API_KEY=
MESHY_API_KEY=

# Optional Studio workers. They never receive provider keys or network access.
WORLDENGINE_BLENDER_EXECUTABLE=
WORLDENGINE_BLENDER_WORKER=../../workers/blender/worker.py
WORLDENGINE_PYTHON_EXECUTABLE=python3
WORLDENGINE_SAM2_WORKER=../../workers/sam2/worker.py
WORLDENGINE_SAM2_CHECKPOINT=
WORLDENGINE_SAM2_CONFIG=sam2.1_hiera_s.yaml

# Optional, required only when accepting WaveSpeed callbacks.
WAVESPEED_WEBHOOK_SECRET=
